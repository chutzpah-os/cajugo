# Copie para .env.local e preencha. Nunca commite .env.local.

# Banco (local: docker compose; staging/prod: Supabase)
DATABASE_URL=postgres://cajugo:cajugo@localhost:5432/cajugo
# Conexão direta para migrations (Supabase: porta 5432, usuário de migrations)
DATABASE_URL_MIGRATIONS=

# Supabase Auth (só servidor)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (só servidor)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Jobs
CRON_SECRET=

APP_URL=http://localhost:3000
