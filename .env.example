# Copie para .env.local e preencha. Nunca commite .env.local.

# Banco: no desenvolvimento, o Supabase de staging (pooler, porta 6543). Os testes usam PGlite e não leem esta variável.
DATABASE_URL=
# Conexão direta para migrations (Supabase: porta 5432, usuário de migrations)
DATABASE_URL_MIGRATIONS=

# Supabase Auth (só servidor)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# WhatsApp de atendimento (só dígitos, com 55 + DDD); vai para settings na spec 002
SUPPORT_WHATSAPP=

# Cloudinary (só servidor)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Jobs
CRON_SECRET=
# Segredo do hash de IP (rate limit, denúncias). Gere com: openssl rand -hex 32
HASH_SECRET=

APP_URL=http://localhost:3000
